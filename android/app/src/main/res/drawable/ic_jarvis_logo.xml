                <item android:offset="1" android:color="#FF12B26F" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M229,134 H236 A7,7 0 0 1 243,141 V215 A7,7 0 0 1 236,222 H229 A7,7 0 0 1 222,215 V141 A7,7 0 0 1 229,134 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="134" android:endX="0" android:endY="222">
                <item android:offset="0" android:color="#FF5AECAC" />
                <item android:offset="1" android:color="#FF12B26F" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
