                <item android:offset="0" android:color="#FF16304F" />
                <item android:offset="1" android:color="#FF050D1B" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M84,98 q11,12 22,0" android:strokeColor="#FF3ED8FF" android:strokeWidth="6.5" android:strokeLineCap="round" />
    <path android:pathData="M118,98 q11,12 22,0" android:strokeColor="#FF3ED8FF" android:strokeWidth="6.5" android:strokeLineCap="round" />

    <!-- Growth bars -->
    <path android:pathData="M175,180 H182 A7,7 0 0 1 189,187 V215 A7,7 0 0 1 182,222 H175 A7,7 0 0 1 168,215 V187 A7,7 0 0 1 175,180 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="134" android:endX="0" android:endY="222">
                <item android:offset="0" android:color="#FF5AECAC" />
                <item android:offset="1" android:color="#FF12B26F" />
