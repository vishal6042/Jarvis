    <path android:pathData="M106,50 H118 A50,50 0 0 1 168,100 V108 A50,50 0 0 1 118,158 H106 A50,50 0 0 1 56,108 V100 A50,50 0 0 1 106,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="56" android:startY="50" android:endX="168" android:endY="216">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.55" android:color="#FFF1F6FC" />
                <item android:offset="1" android:color="#FFC7D6E8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Visor and the smiling eyes -->
    <path android:pathData="M97,74 H127 A27,27 0 0 1 154,101 V105 A27,27 0 0 1 127,132 H97 A27,27 0 0 1 70,105 V101 A27,27 0 0 1 97,74 Z">
