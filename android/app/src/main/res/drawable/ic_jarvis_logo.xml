<?xml version="1.0" encoding="utf-8"?>
<!--
  The Jarvis mark: the assistant, arm around a rising chart. Kept in step with
  assets/brand/jarvis-mark.svg in the repo root - same 256-unit grid, same colours.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="256"
    android:viewportHeight="256">

    <!-- The rising arc: blue as it sweeps under the robot, green as it climbs past the bars -->
    <path
        android:pathData="M44,140 C38,194 70,224 118,224 C168,224 208,190 232,120"
        android:strokeWidth="15"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="44" android:startY="224" android:endX="232" android:endY="120">
                <item android:offset="0" android:color="#FF2AA6F5" />
                <item android:offset="0.45" android:color="#FF2CC5C8" />
                <item android:offset="1" android:color="#FF34D98A" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M243,92 L239,129 L209,108 Z" android:fillColor="#FF34D98A" />

    <!-- Ear pods -->
    <path android:pathData="M36,106 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0 Z" android:fillColor="#FFF4F8FD" />
    <path android:pathData="M45.5,106 a9.5,9.5 0 1,0 19,0 a9.5,9.5 0 1,0 -19,0 Z" android:fillColor="#FF2FC9F2" />
    <path android:pathData="M150,106 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0 Z" android:fillColor="#FFF4F8FD" />
    <path android:pathData="M159.5,106 a9.5,9.5 0 1,0 19,0 a9.5,9.5 0 1,0 -19,0 Z" android:fillColor="#FF2FC9F2" />

    <!-- Antenna -->
    <path android:pathData="M112,58 V34" android:strokeColor="#FFCFE4F5" android:strokeWidth="7" android:strokeLineCap="round" />
    <path android:pathData="M101,24 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0 Z" android:fillColor="#FF3ED8FF" />

    <!-- Torso and neck -->
    <path android:pathData="M78,216 C78,182 93,164 112,164 C131,164 146,182 146,216 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="56" android:startY="50" android:endX="168" android:endY="216">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.55" android:color="#FFF1F6FC" />
                <item android:offset="1" android:color="#FFC7D6E8" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M100,154 h24 v14 h-24 z" android:fillColor="#FFC7D6E8" />

