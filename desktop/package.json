{
  "name": "jarvis-control-center",
  "productName": "Jarvis Control Center",
  "private": true,
  "version": "1.0.0",
  "description": "Start, watch and restart the Jarvis stack from one window.",
  "author": "Vishal Bharti",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "com.jarvis.controlcenter",
    "productName": "Jarvis Control Center",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**", "dist-electron/**"],
    "extraResources": [{ "from": "build/icon.ico", "to": "icon.ico" }],
    "extraMetadata": { "main": "dist-electron/main.js" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jarvis Control Center"
    }
  }
}
